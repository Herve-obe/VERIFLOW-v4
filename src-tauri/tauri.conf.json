{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VERIFLOW",
  "version": "4.0.0-1",
  "identifier": "com.veriflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VERIFLOW",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "backgroundColor": "#0f1115"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Gestion des rushes audio et vidéo",
    "copyright": "Hervé Obejero, GPL-3.0-or-later",
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
